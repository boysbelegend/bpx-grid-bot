{
  "name": "bpx-grid-bot",
  "version": "2.0.0",
  "main": "dist/src/app.js",
  "description": "AMM-Style Spread Trading System for Backpack Exchange - Spot & Futures Grid Bot",
  "repository": "git@github.com:boysbelegend/bpx-grid-bot.git",
  "license": "MIT",
  "author": "boysbelegend",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "yarn build && node dist/src/app.js",
    "start:prod": "yarn build && pm2 start dist/src/app.js --name grid-bot --log gridbot.log",
    "start:sol": "yarn build && node dist/src/app.js config/strategies/sol-amm-grid.json",
    "start:btc": "yarn build && node dist/src/app.js config/strategies/btc-conservative-grid.json",
    "legacy": "tsc && node dist/app.js",
    "stop": "pm2 stop grid-bot",
    "restart": "pm2 restart grid-bot",
    "logs": "pm2 logs grid-bot",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "buffer": "^6.0.3",
    "dotenv": "^16.4.5",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "prettytable": "^0.3.1",
    "qs": "^6.12.0",
    "ws": "^8.17.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "nodemailer": "^6.9.8",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/qs": "^6.9.12",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.8",
    "@types/nodemailer": "^6.4.14",
    "@types/node-cron": "^3.0.11",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@jest/globals": "^29.7.0",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2"
  }
}
