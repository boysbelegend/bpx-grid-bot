{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "lib": ["ES2020"],

    /* Modules */
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Emit */
    "outDir": "./dist",
    "rootDir": "./",
    "removeComments": true,
    "sourceMap": true,

    /* Type Checking */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,

    /* Completeness */
    "forceConsistentCasingInFileNames": true,

    /* Node Types */
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    "src/**/*",
    "app.ts",
    "lib/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
